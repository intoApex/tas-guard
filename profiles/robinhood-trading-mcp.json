    "place_equity_order": {
      "class": "order",
      "asset_class": "equity",
      "note": "Robinhood's docs don't publish argument names, so no order fields are mapped: the value can't be computed and the call needs approval (or is blocked when symbols_allow is set)."
    },
    "place_option_order": {
      "class": "order",
      "asset_class": "option",
      "multiplier": 100,
      "note": "Single-leg only (Robinhood agents can't place multi-leg options orders). Robinhood's docs don't publish argument names, so no order fields are mapped: the value can't be computed and the call needs approval (or is blocked when symbols_allow is set)."
    },
    "place_crypto_order": {
      "class": "order",
